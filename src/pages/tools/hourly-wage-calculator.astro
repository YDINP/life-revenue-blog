</style>

<script is:inline>
const won=n=>Math.round(n).toLocaleString('ko-KR')+'원';
const cint=v=>parseFloat(String(v).replace(/[^0-9.]/g,''))||0;
function fmtInput(el){const raw=el.value.replace(/[^0-9]/g,'');el.value=raw?parseInt(raw,10).toLocaleString('ko-KR'):'';}
const WEEKS_PER_MONTH=365/7/12; // ≈4.345
function calc(scroll){
  const wage=cint(document.getElementById('wage').value);
  const hours=Math.max(0,parseFloat(document.getElementById('hours').value)||0);
  const days=Math.max(0,parseFloat(document.getElementById('days').value)||0);
  if(wage<=0||hours<=0||days<=0)return;
  const weekHours=hours*days;                       // 주 소정근로시간
  const holiHours=weekHours>=15?Math.min(weekHours,40)/40*8:0; // 주휴시간
  const holidayPay=holiHours*wage;                  // 주휴수당(주)
  const basePay=weekHours*wage;                      // 기본 주급
  const weekPay=basePay+holidayPay;                  // 주급(주휴 포함)
  const monthPay=weekPay*WEEKS_PER_MONTH;            // 월 예상급여
  // render
  document.getElementById('out').style.display='block';
  document.getElementById('cta').style.display='block';
  document.getElementById('r-month').textContent=won(monthPay);
  const holiNote=weekHours>=15?`주휴수당 ${won(holidayPay)} 포함`:'주 15시간 미만이라 주휴수당 없음';
  document.getElementById('r-sent').textContent=`주 ${weekHours.toLocaleString('ko-KR')}시간 근무 기준, ${holiNote}. 세전 예상 금액입니다.`;
  document.getElementById('r-week').textContent=won(weekPay);
  document.getElementById('r-holiday').textContent=won(holidayPay);
  document.getElementById('r-hours').textContent=weekHours.toLocaleString('ko-KR')+'시간';
  document.getElementById('d-base').textContent=won(basePay);
  document.getElementById('d-holiday').textContent=won(holidayPay);
  document.getElementById('d-holihours').textContent=holiHours.toLocaleString('ko-KR',{maximumFractionDigits:1})+'시간';
  document.getElementById('d-weeks').textContent='× '+WEEKS_PER_MONTH.toFixed(3)+'주';
  document.getElementById('d-month').textContent=won(monthPay);
  const basePct=weekPay>0?Math.max(0,Math.min(100,basePay/weekPay*100)):100;
  document.getElementById('seg-base').style.width=basePct+'%';
  document.getElementById('seg-holi').style.width=(100-basePct)+'%';
  document.getElementById('leg-base').textContent=won(basePay);
  document.getElementById('leg-holi').textContent=won(holidayPay);
  const hh=document.getElementById('whint');
  if(hh)hh.textContent=weekHours>=15?`주 ${weekHours.toLocaleString('ko-KR')}시간 → 주휴시간 ${holiHours.toLocaleString('ko-KR',{maximumFractionDigits:1})}시간 발생`:`주 ${weekHours.toLocaleString('ko-KR')}시간 → 15시간 미만, 주휴수당 없음`;
  const h=document.getElementById('resHead');
  if(scroll){h.focus();document.getElementById('out').scrollIntoView({behavior:'smooth',block:'start'});}
}
function subscribe(){
  const e=document.getElementById('email').value.trim();const msg=document.getElementById('cta-msg');
  if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e)){msg.textContent='올바른 이메일 주소를 입력해 주세요.';msg.style.color='#fb7185';return;}
  try{fetch('https://xyprbsmagtlzebxyxsvj.supabase.co/functions/v1/analytics-ingest',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({event_type:'newsletter_subscribe',source:'lifeflow',metadata:{email:e,campaign:'hourly-wage-calculator',page:location.pathname,subscribed_at:new Date().toISOString()}})}).catch(()=>{});}catch(_){}
  msg.textContent='감사합니다! 무료 근무·급여 관리 시트 소식을 보내드릴게요.';msg.style.color='#34d399';
  try{localStorage.setItem('newsletter-subscribed','true');}catch(_){}
  document.getElementById('email').value='';
}
document.getElementById('wage').addEventListener('input',e=>fmtInput(e.target));
calc(false);
</script>

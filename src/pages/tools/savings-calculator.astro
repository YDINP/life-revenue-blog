---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '예·적금 이자 계산기 2026';
const description = '예금·적금에 넣으면 만기에 얼마나 받을까? 단리/월복리, 이자과세(일반 15.4%·세금우대 9.5%·비과세)까지 반영해 세전·세후 수령액과 총이자를 바로 계산합니다. 무료·설치 불필요.';
const ogImage = '/og/savings-calculator.png';

const appLd = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: '예·적금 이자 계산기 2026', applicationCategory: 'FinanceApplication', operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  description: '예금·적금의 단리/월복리 이자와 이자과세(15.4%·9.5%·비과세)를 반영해 만기 세전·세후 수령액을 계산하는 무료 도구.',
};
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: '단리와 복리는 어떻게 다른가요?', acceptedAnswer: { '@type': 'Answer', text: '단리는 원금에만 이자가 붙지만, 월복리는 매달 붙은 이자가 다시 원금에 더해져 다음 달 이자의 기준이 됩니다. 기간이 길고 이율이 높을수록 복리가 유리하며, 같은 조건이면 복리 수령액이 단리보다 큽니다.' } },
    { '@type': 'Question', name: '이자과세 15.4%는 무엇인가요?', acceptedAnswer: { '@type': 'Answer', text: '예·적금 이자에는 이자소득세 14%와 지방소득세 1.4%를 합한 15.4%가 원천징수됩니다. 원금이 아니라 발생한 이자에만 부과되며, 세금우대는 9.5%, 비과세 상품은 0%가 적용됩니다.' } },
    { '@type': 'Question', name: '비과세 상품은 어떤 조건인가요?', acceptedAnswer: { '@type': 'Answer', text: '비과세종합저축(만 65세 이상·장애인 등), 청년우대형·조합 예탁금 등 법에서 정한 요건을 갖춘 상품은 이자에 세금이 붙지 않습니다. 가입 대상·한도가 정해져 있어 가입 전 확인이 필요합니다.' } },
    { '@type': 'Question', name: '적금은 왜 예금보다 이자가 적나요?', acceptedAnswer: { '@type': 'Answer', text: '적금은 매달 나눠 넣어 각 회차 납입금이 예치되는 기간이 다릅니다. 첫 달 납입금만 전 기간 이자를 받고 마지막 달 납입금은 한 달만 이자가 붙어, 같은 총액·이율이라도 예금(일시 예치)보다 실제 이자가 적습니다.' } },
  ],
};
---
<BaseLayout title={title} description={description} image={ogImage} ogType="website">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <div class="dpc">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>단리·월복리 · 이자과세 반영 · 무료</span>
      <h1>예·적금 이자 계산기 <span class="grad">2026</span></h1>
      <p class="sub">예금·적금에 넣으면 만기에 실제로 얼마를 받을까요? 단리/월복리와 <b>이자과세(15.4%·9.5%·비과세)</b>까지 반영해 세전·세후 수령액을 바로 계산합니다.</p>

      <form id="calcForm" onsubmit="event.preventDefault();calc(true)">
      <div class="card">
        <div class="card-h"><span class="n">1</span><h2>상품 정보 입력</h2></div>

        <span class="seg-cap">상품 유형</span>
        <div class="seg-toggle" id="typeToggle">
          <button type="button" class="seg-btn active" data-val="deposit" onclick="setSeg(this)">예금<small>거치식 · 목돈 일시예치</small></button>
          <button type="button" class="seg-btn" data-val="installment" onclick="setSeg(this)">적금<small>적립식 · 매월 납입</small></button>
        </div>

        <div class="frow">
          <div class="fld"><span class="cap" id="amtCap">예치 원금 (원)</span><input id="amount" inputmode="numeric" aria-label="금액(원)" value="10,000,000" oninput="fmtInput(this)"></div>
          <div class="fld"><span class="cap">기간 (개월)</span><input id="months" type="number" min="1" step="1" aria-label="기간(개월)" value="12"></div>
        </div>
        <div class="frow">
          <div class="fld"><span class="cap">연이자율 (%)</span><input id="rate" type="number" min="0" step="0.1" aria-label="연이자율(%)" value="3.5"></div>
          <div class="fld"><span class="cap">이자과세</span>
            <select id="tax" aria-label="이자과세">
              <option value="0.154">일반과세 (15.4%)</option>
              <option value="0.095">세금우대 (9.5%)</option>
              <option value="0">비과세 (0%)</option>
            </select>
          </div>
        </div>

        <span class="seg-cap">이자 방식</span>
        <div class="seg-toggle" id="methodToggle">
          <button type="button" class="seg-btn active" data-val="simple" onclick="setSeg(this)">단리<small>원금에만 이자</small></button>
          <button type="button" class="seg-btn" data-val="compound" onclick="setSeg(this)">월복리<small>이자에 이자</small></button>
        </div>

        <div class="strat">
          <button type="submit" class="go">이자 계산</button>
        </div>
        <p class="tip">이자에는 <b>이자소득세 15.4%</b>(세금우대 9.5%, 비과세 0%)가 원천징수됩니다. 적금은 매달 나눠 넣어 같은 총액·이율이라도 예금보다 실제 이자가 적습니다.</p>
      </div>
      </form>

      <div class="card" id="out">
        <div class="card-h"><span class="n">2</span><h2 id="resHead" tabindex="-1">계산 결과</h2></div>
        <div class="hero-lbl">세후 수령액 (만기)</div>
        <div class="res-hero"><span class="big grad" id="r-net">–</span><span class="permo">원</span></div>
        <div class="hero-sent" id="r-sent"></div>
        <div class="kpis">
          <div class="kpi"><div class="l">만기 수령액 (세전)</div><div class="v em" id="r-gross">–</div></div>
          <div class="kpi"><div class="l">세전 총이자</div><div class="v" id="r-grossint">–</div></div>
          <div class="kpi"><div class="l">이자과세액</div><div class="v bl" id="r-tax">–</div></div>
        </div>
        <div class="barwrap">
          <div class="stackbar" id="stackbar"><div class="seg net" id="seg-prin"></div><div class="seg ded" id="seg-int"></div></div>
          <div class="barleg"><span><i class="net"></i>원금 <b id="leg-prin"></b></span><span><i class="ded"></i>세후 이자 <b id="leg-int"></b></span></div>
        </div>
        <div class="brk">
          <div class="brk-t">수령액 내역</div>
          <div class="brk-row"><span>원금 합계</span><b id="d-prin">–</b></div>
          <div class="brk-row"><span>세전 총이자</span><b id="d-grossint">–</b></div>
          <div class="brk-row"><span>이자과세 <em id="d-taxrate">15.4%</em></span><b id="d-tax">–</b></div>
          <div class="brk-row"><span>세후 총이자</span><b id="d-netint">–</b></div>
          <div class="brk-row total pos"><span>세후 수령액</span><b id="d-total">–</b></div>
        </div>
      </div>

      <div class="cta" id="cta" style="display:none">
        <h3>💡 이자 굴리는 돈, 한눈에 관리하고 싶다면</h3>
        <p>예·적금 만기와 목표 저축액을 한 화면에서 관리하는 <b>무료 가계부 시트</b>를 보내드려요. 정식 재무 대시보드는 출시 때 얼리버드 가격으로 가장 먼저 안내드립니다.</p>
        <div class="emailrow">
          <input id="email" type="email" placeholder="이메일 주소" aria-label="이메일 주소">
          <button type="button" onclick="subscribe()">무료 시트 받기</button>
        </div>
        <div class="fine" id="cta-msg" aria-live="polite">스팸 없이 재무 도구 소식만. 언제든 해지할 수 있어요.</div>
      </div>

      <div class="content">
        <h2>예금과 적금, 뭐가 다른가요?</h2>
        <p><b>예금(거치식)</b>은 목돈을 한 번에 예치하고 만기까지 두는 방식이라 전 기간 동안 원금 전체에 이자가 붙습니다. <b>적금(적립식)</b>은 매달 일정액을 나눠 넣어, 각 회차 납입금이 예치되는 기간이 달라 같은 총액·이율이라도 실제 이자가 예금보다 적습니다.</p>
        <h2>단리 vs 월복리</h2>
        <ul>
          <li><b>단리</b> — 원금에만 이자가 붙습니다. 이자 = 원금 × 연이율 × 기간.</li>
          <li><b>월복리</b> — 매달 붙은 이자가 원금에 더해져 다음 달 이자의 기준이 됩니다. 기간이 길고 이율이 높을수록 복리 효과가 커집니다.</li>
        </ul>
        <h2>이자과세 (세금)</h2>
        <p>예·적금 이자에는 <b>이자소득세 14% + 지방소득세 1.4% = 15.4%</b>가 원천징수됩니다. 원금이 아니라 발생한 이자에만 부과됩니다. 세금우대 상품은 9.5%, 법에서 정한 요건을 갖춘 비과세 상품은 0%가 적용됩니다.</p>
        <h2>자주 묻는 질문</h2>
        <h3>비과세 상품은 어떤 조건인가요?</h3>
        <p>비과세종합저축(만 65세 이상·장애인 등), 청년우대형, 조합 예탁금 등 법에서 정한 요건을 갖춘 상품은 이자에 세금이 붙지 않습니다. 가입 대상과 한도가 정해져 있어 가입 전 확인이 필요합니다.</p>
        <h3>실제 은행 만기액과 다를 수 있나요?</h3>
        <p>네. 은행은 이자를 일수 기준으로 계산하고 우대금리·중도해지·이자 지급 방식이 상품마다 달라 소폭 차이가 날 수 있습니다. 이 계산기는 월 단위 <b>예상치</b>입니다.</p>
      </div>

      <p class="disc">참고용 계산기입니다. 이자는 월 단위로 근사 계산하며 은행의 일수 기준 계산·우대금리·중도해지 조건에 따라 실제 만기 수령액과 다를 수 있습니다. 이자과세는 선택한 세율(일반 15.4%·세금우대 9.5%·비과세 0%)을 이자에 적용합니다. 입력값은 서버로 전송되지 않고 브라우저에서만 계산됩니다.</p>
    </div>
  </div>
</BaseLayout>

<style is:global>
.dpc{--grad:linear-gradient(135deg,#34d399,#22d3ee);--radius:18px;
  --surface:#ffffff;--surface2:#f4f7fb;--line:#e5eaf1;--line2:#d4dce7;
  --text:#0f1a2b;--mut:#48566b;--dim:#6a7889;--emerald:#0c9c6b;--teal:#0d7d9c;--rose:#e11d63;
  --gradtext:linear-gradient(135deg,#0aa06e,#0d86a6);
  --shadow:0 10px 30px -14px rgba(20,45,90,.16);--panelborder:#e6ecf3;
  --panel:radial-gradient(700px 400px at 12% -8%,rgba(52,211,153,.07),transparent 60%),radial-gradient(600px 400px at 100% 0%,rgba(34,211,238,.06),transparent 55%),linear-gradient(180deg,#f8fbfe,#eef3f9);
  max-width:920px;margin:26px auto;padding:28px 22px 32px;border-radius:24px;border:1px solid var(--panelborder);
  background:var(--panel);color:var(--text);
  font-family:"Pretendard Variable",Pretendard,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;line-height:1.55;letter-spacing:-.01em;-webkit-font-smoothing:antialiased}
html.dark .dpc{--surface:#121c2e;--surface2:#0e1626;--line:#1f2c42;--line2:#2a3a56;
  --text:#eef2f8;--mut:#9fb0c6;--dim:#8b97ac;--emerald:#34d399;--teal:#22d3ee;--rose:#fb7185;
  --gradtext:linear-gradient(135deg,#34d399,#22d3ee);
  --shadow:0 12px 40px -12px rgba(0,0,0,.55);--panelborder:#17233a;
  --panel:radial-gradient(700px 400px at 12% -8%,rgba(52,211,153,.10),transparent 60%),radial-gradient(600px 400px at 100% 0%,rgba(34,211,238,.08),transparent 55%),linear-gradient(180deg,#0d1524,#0a0f1a)}
.dpc *{box-sizing:border-box;margin:0;padding:0}
.dpc .wrap{max-width:100%;margin:0 auto}
.dpc .eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--emerald);background:rgba(52,211,153,.10);border:1px solid rgba(52,211,153,.22);padding:5px 12px;border-radius:999px;margin-bottom:16px}
.dpc .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--emerald);box-shadow:0 0 0 3px rgba(52,211,153,.2)}
.dpc h1{font-size:clamp(26px,5vw,38px);font-weight:800;line-height:1.12;letter-spacing:-.03em;color:var(--text)}
.dpc .grad{background:var(--gradtext);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.dpc .sub{color:var(--mut);font-size:16px;margin:12px 0 26px;max-width:640px}
.dpc .card{background:linear-gradient(180deg,var(--surface),var(--surface2));border:1px solid var(--line);border-radius:var(--radius);padding:22px;margin-bottom:18px;box-shadow:var(--shadow)}
.dpc .card-h{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.dpc .card-h .n{width:26px;height:26px;border-radius:8px;background:rgba(52,211,153,.12);color:var(--emerald);display:grid;place-items:center;font-size:13px;font-weight:700}
.dpc .card-h h2{font-size:16.5px;font-weight:700;letter-spacing:-.02em;color:var(--text)}
.dpc .frow{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.dpc .fld{position:relative}
.dpc .fld .cap{display:block;font-size:12px;color:var(--mut);font-weight:600;margin-bottom:5px}
.dpc .fld input{width:100%;background:var(--surface2);border:1px solid var(--line);border-radius:11px;padding:11px 12px;color:var(--text);font-size:15px;font-family:inherit;transition:border-color .15s,box-shadow .15s}
.dpc .fld input::placeholder{color:var(--dim)}
.dpc .fld input:focus{outline:none;border-color:var(--emerald);box-shadow:0 0 0 3px rgba(52,211,153,.14)}
.dpc .strat{display:flex;margin-top:6px}
.dpc .go{margin-left:auto;background:var(--grad);color:#04121b;border:none;border-radius:12px;padding:12px 26px;font-weight:800;font-size:15px;font-family:inherit;cursor:pointer;box-shadow:0 8px 22px -8px rgba(52,211,153,.6);transition:transform .12s,filter .15s}
.dpc .go:hover{filter:brightness(1.05)}.dpc .go:active{transform:translateY(1px)}
.dpc .tip{font-size:13px;color:var(--mut);margin-top:14px;line-height:1.5}
.dpc .tip b{color:var(--text)}
.dpc button:focus-visible,.dpc input:focus-visible{outline:2px solid var(--teal);outline-offset:2px}
.dpc #out{display:none}
.dpc .hero-lbl{font-size:13px;color:var(--mut);font-weight:600;margin:2px 0}
.dpc .res-hero{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;padding:0 2px 4px;background:none;border-radius:0;text-align:left;margin:0}
.dpc .res-hero .big{font-size:clamp(30px,7vw,46px);font-weight:800;letter-spacing:-.03em}
.dpc .permo{font-size:16px;color:var(--mut);font-weight:600}
.dpc .hero-sent{font-size:15px;color:var(--mut);margin:2px 2px 18px}
.dpc .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.dpc .kpi{background:var(--surface2);border:1px solid var(--line);border-radius:14px;padding:15px 16px}
.dpc .kpi .l{font-size:12.5px;color:var(--mut);font-weight:600}
.dpc .kpi .v{font-size:20px;font-weight:800;margin-top:5px;letter-spacing:-.02em;color:var(--text)}
.dpc .v.em{color:var(--emerald)}.dpc .v.bl{color:var(--teal)}
.dpc .barwrap{margin-top:18px}
.dpc .stackbar{display:flex;height:30px;border-radius:9px;overflow:hidden;border:1px solid var(--line);background:var(--surface2)}
.dpc .stackbar .seg{height:100%}
.dpc .stackbar .seg.net{background:linear-gradient(90deg,#34d399,#22d3ee)}
.dpc .stackbar .seg.ded{background:repeating-linear-gradient(45deg,var(--line2),var(--line2) 6px,var(--surface2) 6px,var(--surface2) 12px)}
.dpc .barleg{display:flex;gap:16px;font-size:12.5px;color:var(--mut);margin-top:8px}
.dpc .barleg i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:middle}
.dpc .barleg i.net{background:#22d3ee}.dpc .barleg i.ded{background:var(--line2)}
.dpc .barleg b{color:var(--text)}
.dpc .brk{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}
.dpc .brk-t{font-size:13px;color:var(--mut);font-weight:700;margin-bottom:8px}
.dpc .brk-row{display:flex;justify-content:space-between;align-items:center;padding:8px 2px;font-size:14.5px;border-bottom:1px solid var(--line)}
.dpc .brk-row span{color:var(--text)}
.dpc .brk-row em{font-style:normal;font-size:12px;color:var(--dim);margin-left:6px}
.dpc .brk-row b{color:var(--text);font-weight:700}
.dpc .brk-row.total{border-bottom:none;margin-top:4px;font-weight:800}
.dpc .brk-row.total span,.dpc .brk-row.total b{color:var(--rose);font-size:15.5px}
.dpc .cta{background:linear-gradient(135deg,#0f2740,#12233a);border:1px solid #274563;border-radius:var(--radius);padding:24px;position:relative;overflow:hidden;margin-bottom:18px}
.dpc .cta::before{content:"";position:absolute;inset:0;background:radial-gradient(400px 160px at 90% 0%,rgba(34,211,238,.14),transparent 70%);pointer-events:none}
.dpc .cta h3{font-size:19px;font-weight:800;letter-spacing:-.02em;margin-bottom:7px;position:relative;color:#f2f7fb}
.dpc .cta p{color:#aabdd0;font-size:14px;margin-bottom:14px;max-width:580px;position:relative}
.dpc .cta .fine{color:#8097ad}
.dpc .emailrow{display:flex;gap:9px;flex-wrap:wrap;position:relative}
.dpc .cta .emailrow input{flex:1;min-width:220px;background:#0d1b2c;border:1px solid #26445f;border-radius:12px;padding:12px 14px;color:#eef2f8;font-size:14.5px;font-family:inherit}
.dpc .cta .emailrow input::placeholder{color:#7089a0}
.dpc .emailrow button{background:var(--grad);color:#04121b;border:none;border-radius:12px;padding:12px 22px;font-weight:800;font-size:14.5px;font-family:inherit;cursor:pointer;transition:.15s}
.dpc .emailrow button:hover{filter:brightness(1.05)}
.dpc .fine{font-size:11.5px;margin-top:10px;position:relative}
.dpc .content{color:var(--mut);font-size:15px}
.dpc .content h2{font-size:19px;color:var(--text);font-weight:800;letter-spacing:-.02em;margin:26px 0 10px}
.dpc .content h3{font-size:15.5px;color:var(--text);font-weight:700;margin:16px 0 4px}
.dpc .content p{margin-bottom:8px}
.dpc .content ul{margin:6px 0 6px 18px}.dpc .content li{margin-bottom:5px}
.dpc .disc{font-size:12px;color:var(--dim);margin-top:22px;line-height:1.6}
@media(max-width:600px){
  .dpc{padding:20px 14px 24px;margin:16px auto;border-radius:18px}
  .dpc .frow{grid-template-columns:1fr}
  .dpc .kpis{grid-template-columns:1fr}
  .dpc .go{width:100%}
}
/* --- tool-specific: segment toggle + select --- */
.dpc .seg-cap{display:block;font-size:12px;color:var(--mut);font-weight:600;margin-bottom:5px}
.dpc .seg-toggle{display:flex;gap:6px;background:var(--surface2);border:1px solid var(--line);border-radius:12px;padding:5px;margin-bottom:12px}
.dpc .seg-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;background:transparent;border:none;border-radius:9px;padding:9px 8px;color:var(--mut);font-family:inherit;font-size:14.5px;font-weight:700;cursor:pointer;transition:background .15s,color .15s}
.dpc .seg-btn small{font-size:10.5px;font-weight:500;color:var(--dim)}
.dpc .seg-btn.active{background:var(--grad);color:#04121b}
.dpc .seg-btn.active small{color:#06303a}
.dpc select{width:100%;background:var(--surface2);border:1px solid var(--line);border-radius:11px;padding:11px 12px;color:var(--text);font-size:15px;font-family:inherit;transition:border-color .15s,box-shadow .15s}
.dpc select:focus{outline:none;border-color:var(--emerald);box-shadow:0 0 0 3px rgba(52,211,153,.14)}
.dpc .brk-row.total.pos span,.dpc .brk-row.total.pos b{color:var(--emerald)}
</style>

<script is:inline>
const won=n=>Math.round(n).toLocaleString('ko-KR')+'원';
const cint=v=>parseFloat(String(v).replace(/[^0-9.]/g,''))||0;
function fmtInput(el){const raw=el.value.replace(/[^0-9]/g,'');el.value=raw?parseInt(raw,10).toLocaleString('ko-KR'):'';}
function setSeg(el){
  const group=el.parentElement;
  group.querySelectorAll('.seg-btn').forEach(b=>b.classList.remove('active'));
  el.classList.add('active');
  if(group.id==='typeToggle'){
    const cap=document.getElementById('amtCap');
    cap.textContent=el.dataset.val==='installment'?'월 납입액 (원)':'예치 원금 (원)';
  }
  calc(false);
}
function calc(scroll){
  const type=(document.querySelector('#typeToggle .active')||{}).dataset?.val||'deposit';
  const method=(document.querySelector('#methodToggle .active')||{}).dataset?.val||'simple';
  const amount=cint(document.getElementById('amount').value);
  const months=Math.max(0,parseInt(document.getElementById('months').value)||0);
  const rate=parseFloat(document.getElementById('rate').value)||0;
  const taxRate=parseFloat(document.getElementById('tax').value)||0;
  if(amount<=0||months<=0||rate<0)return;
  const r=rate/100, mr=r/12, n=months;
  let principal, interest, grossMaturity;
  if(type==='deposit'){
    principal=amount;
    if(method==='compound'){
      grossMaturity=principal*Math.pow(1+mr,n);
      interest=grossMaturity-principal;
    }else{
      interest=principal*r*(n/12);
      grossMaturity=principal+interest;
    }
  }else{ // 적금
    principal=amount*n;
    if(method==='compound'){
      if(mr===0){ grossMaturity=principal; }
      else{ grossMaturity=amount*(Math.pow(1+mr,n+1)-(1+mr))/mr; }
      interest=grossMaturity-principal;
    }else{
      interest=amount*mr*(n*(n+1)/2);
      grossMaturity=principal+interest;
    }
  }
  interest=Math.max(0,interest);
  const tax=interest*taxRate;
  const netInterest=interest-tax;
  const netMaturity=grossMaturity-tax;
  // render
  document.getElementById('out').style.display='block';
  document.getElementById('cta').style.display='block';
  document.getElementById('r-net').textContent=Math.round(netMaturity).toLocaleString('ko-KR');
  document.getElementById('r-sent').textContent=`원금 ${won(principal)}에 세후 이자 ${won(netInterest)}가 붙습니다.`;
  document.getElementById('r-gross').textContent=won(grossMaturity);
  document.getElementById('r-grossint').textContent=won(interest);
  document.getElementById('r-tax').textContent=won(tax);
  const pct=(taxRate*100);
  document.getElementById('d-taxrate').textContent=(Number.isInteger(pct)?pct:pct.toFixed(1))+'%';
  document.getElementById('d-prin').textContent=won(principal);
  document.getElementById('d-grossint').textContent=won(interest);
  document.getElementById('d-tax').textContent='-'+won(tax);
  document.getElementById('d-netint').textContent=won(netInterest);
  document.getElementById('d-total').textContent=won(netMaturity);
  const prinPct=grossMaturity>0?Math.max(0,Math.min(100,principal/(principal+netInterest)*100)):100;
  document.getElementById('seg-prin').style.width=prinPct+'%';
  document.getElementById('seg-int').style.width=(100-prinPct)+'%';
  document.getElementById('leg-prin').textContent=won(principal);
  document.getElementById('leg-int').textContent=won(netInterest);
  const h=document.getElementById('resHead');
  if(scroll){h.focus();document.getElementById('out').scrollIntoView({behavior:'smooth',block:'start'});}
}
function subscribe(){
  const e=document.getElementById('email').value.trim();const msg=document.getElementById('cta-msg');
  if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e)){msg.textContent='올바른 이메일 주소를 입력해 주세요.';msg.style.color='#fb7185';return;}
  try{fetch('https://xyprbsmagtlzebxyxsvj.supabase.co/functions/v1/analytics-ingest',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({event_type:'newsletter_subscribe',source:'lifeflow',metadata:{email:e,campaign:'savings-calculator',page:location.pathname,subscribed_at:new Date().toISOString()}})}).catch(()=>{});}catch(_){}
  msg.textContent='감사합니다! 무료 가계부 시트와 대시보드 소식을 보내드릴게요.';msg.style.color='#34d399';
  try{localStorage.setItem('newsletter-subscribed','true');}catch(_){}
  document.getElementById('email').value='';
}
document.getElementById('amount').addEventListener('input',e=>fmtInput(e.target));
calc(false);
</script>
